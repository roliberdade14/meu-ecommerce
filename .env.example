# Copie os NOMES abaixo para Vercel > Settings > Environment Variables e preencha lá.
# Nunca commite um arquivo .env com valores reais.

# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=
# Chave SECRETA do Supabase (sb_secret_... ou a antiga service_role). Só no servidor.
SUPABASE_SECRET_KEY=
# Texto aleatório longo (32+ caracteres) para transformar o IP em hash
IP_HASH_SALT=
# Opcional: domínios que podem enviar o formulário, separados por vírgula
# ALLOWED_ORIGINS=https://meu-ecommerce.vercel.app,https://www.seudominio.com.br
